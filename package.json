{
  "name": "headless-vibe",
  "version": "0.1.0",
  "description": "A reusable Next.js starter for Shopify headless storefronts.",
  "private": true,
  "workspaces": [
    "studio"
  ],
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.1",
      "smol-toml": "1.8.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --import=./tests/setup.mjs --conditions=react-server --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test",
    "test:e2e": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.e2e.local ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.e2e.local ./node_modules/@playwright/test/cli.js test --ui",
    "graphql:codegen": "node scripts/generate-shopify-graphql.mjs",
    "studio:dev": "npm run dev --workspace studio",
    "studio:build": "npm run build --workspace studio",
    "studio:typecheck": "npm run typecheck --workspace studio",
    "studio:deploy": "npm run deploy --workspace studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@countrystatecity/countries": "^1.0.9",
    "@sanity/image-url": "^2.1.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-sanity": "^13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "graphql": "^17.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
