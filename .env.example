# Shopify: use your permanent myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Recommended for server-rendered storefronts. Keep this value secret.
# Legacy account pages also require customer read/write Storefront permissions.
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=

# Optional alternative for public Storefront API access.
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=

# Optional. Defaults to the stable version used by this starter.
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Sanity project identifiers are public and safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed for private datasets or draft content. Never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_API_VERSION=2026-08-27

# Klaviyo newsletter integration. Keep the private API key server-only.
# The private key needs lists:write, profiles:write, and subscriptions:write scopes.
KLAVIYO_LIST_ID=
KLAVIYO_API_KEY=
